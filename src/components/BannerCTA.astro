---
---

<section class="banner-cta-section" id="cta-intermedio">
  <div class="banner-overlay"></div>
  <div class="container banner-container">
    <div class="banner-content">
      <span class="banner-eyebrow">TRANSFORMACIÓN DIGITAL EFECTIVA</span>
      <h2 class="banner-title">
        Construyamos el Software que Tu Empresa Necesita para Liderar su Sector
      </h2>
      <p class="banner-desc">
        Hablemos de tus requerimientos específicos, alcance técnico y cómo podemos optimizar la arquitectura de tus procesos en tiempo récord.
      </p>
      <div class="banner-actions">
        <a href="#contacto" class="btn-primary banner-btn">
          <span>SOLICITA UNA ASESORÍA SIN COSTO</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .banner-cta-section {
    position: relative;
    padding-block: 100px;
    background-color: #0B111E;
    background-image: radial-gradient(circle at 50% 50%, rgba(0, 112, 245, 0.18) 0%, transparent 60%);
    color: #FFFFFF;
    text-align: center;
    overflow: hidden;
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  .banner-container {
    position: relative;
    z-index: 2;
  }

  .banner-content {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .banner-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: #60A5FA;
    letter-spacing: 2px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .banner-title {
    font-size: clamp(2.1rem, 3.8vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .banner-desc {
    font-size: 1.15rem;
    color: #CBD5E1;
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 680px;
  }

  .banner-btn {
    padding: 16px 38px;
    font-size: 0.95rem;
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .banner-btn:hover .btn-arrow {
    transform: translateX(4px);
  }
</style>
