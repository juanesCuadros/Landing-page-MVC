---
---

<section class="contact-section section-padding" id="contacto">
  <div class="container">
    <div class="contact-grid">
      <!-- Columna izquierda: Título, promesa y card de confianza -->
      <div class="contact-left">
        <span class="mono-eyebrow">AGENDA TU DIAGNÓSTICO</span>
        <h2 class="contact-title">
          ¿Listo para llevar tu <strong>software</strong> al siguiente nivel de escala?
        </h2>
        <p class="contact-lead">
          Cuéntanos sobre tu proyecto. En menos de 24 horas hábiles, un arquitecto de soluciones de nuestro equipo revisará tus requerimientos y te contactará para coordinar una sesión técnica sin costo.
        </p>

        <!-- Tarjeta de confianza con radio grande (40px) según brief -->
        <div class="trust-card">
          <div class="trust-header">
            <div class="trust-avatar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>
            <div>
              <h3 class="trust-name">Asesoría de Arquitectura Directa</h3>
              <p class="trust-role">Ingenieros Senior, no comerciales agresivos</p>
            </div>
          </div>
          <ul class="trust-bullets">
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" class="t-check"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Firma de Acuerdo de Confidencialidad (NDA) antes de revisar código o datos.</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" class="t-check"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Estimación presupuestal clara sin costos ocultos por hora.</span>
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" class="t-check"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>Análisis de viabilidad técnica y propuesta de stack recomendado.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Columna derecha: Panel gris-azulado con formulario de calificación -->
      <div class="contact-right">
        <div class="form-panel">
          <div class="form-header">
            <h3 class="form-panel-title">Perfil de tu Proyecto</h3>
            <p class="form-panel-subtitle">Completa los campos para asignarte el especialista adecuado:</p>
          </div>

          <form id="project-contact-form" class="project-form">
            <div class="form-row-2">
              <div class="input-group">
                <label for="form-nombre">Nombre *</label>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                  </span>
                  <input type="text" id="form-nombre" name="nombre" placeholder="Ej. Carlos" required />
                </div>
              </div>
              <div class="input-group">
                <label for="form-apellido">Apellido *</label>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                  </span>
                  <input type="text" id="form-apellido" name="apellido" placeholder="Ej. Mendoza" required />
                </div>
              </div>
            </div>

            <div class="form-row-2">
              <div class="input-group">
                <label for="form-email">Correo Corporativo *</label>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                  </span>
                  <input type="email" id="form-email" name="email" placeholder="carlos@tuempresa.com" required />
                </div>
              </div>
              <div class="input-group">
                <label for="form-empresa">Empresa / Negocio *</label>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
                      <path d="M9 22v-4h6v4" />
                      <line x1="8" y1="6" x2="8.01" y2="6" />
                      <line x1="16" y1="6" x2="16.01" y2="6" />
                      <line x1="12" y1="6" x2="12.01" y2="6" />
                      <line x1="12" y1="10" x2="12.01" y2="10" />
                      <line x1="12" y1="14" x2="12.01" y2="14" />
                      <line x1="16" y1="10" x2="16.01" y2="10" />
                      <line x1="16" y1="14" x2="16.01" y2="14" />
                      <line x1="8" y1="10" x2="8.01" y2="10" />
                      <line x1="8" y1="14" x2="8.01" y2="14" />
                    </svg>
                  </span>
                  <input type="text" id="form-empresa" name="empresa" placeholder="Nombre de tu empresa" required />
                </div>
              </div>
            </div>

            <div class="input-group">
              <label for="form-celular">Celular / WhatsApp *</label>
              <div class="phone-input-wrapper">
                <div class="country-prefix">
                  <span>COL</span>
                  <span>+57</span>
                </div>
                <input type="tel" id="form-celular" name="celular" placeholder="300 123 4567" required />
              </div>
            </div>

            <div class="form-row-2">
              <div class="input-group">
                <label for="form-solucion">Tipo de Solución *</label>
                <div class="input-wrapper select-wrapper">
                  <select id="form-solucion" name="solucion" required>
                    <option value="" disabled selected>Selecciona una opción</option>
                    <option value="desarrollo-a-medida">Desarrollo Web a la Medida (Java + React)</option>
                    <option value="automatizacion-n8n">Automatización de Procesos (n8n)</option>
                    <option value="bi-data">Business Intelligence & Dashboards</option>
                    <option value="modernizacion-legacy">Modernización de Sistema Legacy</option>
                    <option value="apis-integraciones">APIs & Integraciones CRM (Kommo)</option>
                  </select>
                </div>
              </div>

              <div class="input-group">
                <label for="form-estado">Estado del Proyecto *</label>
                <div class="input-wrapper select-wrapper">
                  <select id="form-estado" name="estado" required>
                    <option value="" disabled selected>Fase actual</option>
                    <option value="idea-requerimientos">Idea o requerimientos iniciales</option>
                    <option value="especificacion-lista">Especificación técnica lista</option>
                    <option value="sistema-en-produccion">Sistema en producción a refactorizar</option>
                    <option value="rescate-proveedor">Rescate urgente de proyecto</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="form-row-2">
              <div class="input-group">
                <label for="form-necesidad">Necesidad Principal *</label>
                <div class="input-wrapper select-wrapper">
                  <select id="form-necesidad" name="necesidad" required>
                    <option value="" disabled selected>Objetivo principal</option>
                    <option value="automatizar-operacion">Automatizar operaciones y ahorrar horas</option>
                    <option value="escalar-concurrencia">Soportar mayor volumen de usuarios</option>
                    <option value="lanzar-producto">Lanzar nuevo producto o servicio</option>
                    <option value="visibilidad-datos">Centralizar datos para toma de decisiones</option>
                  </select>
                </div>
              </div>

              <div class="input-group">
                <label for="form-presupuesto">Rango de Presupuesto Estimado</label>
                <div class="input-wrapper select-wrapper">
                  <select id="form-presupuesto" name="presupuesto">
                    <option value="" disabled selected>Presupuesto aproxi.</option>
                    <option value="15-30m">$15M a $30M COP</option>
                    <option value="30-60m">$30M a $60M COP</option>
                    <option value="60-120m">$60M a $120M COP</option>
                    <option value="enterprise">+ $120M COP (Enterprise)</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="input-group">
              <label for="form-detalles">Breve descripción de lo que deseas construir o solucionar</label>
              <textarea id="form-detalles" name="detalles" rows="3" placeholder="Describe brevemente el flujo, problema actual o meta del software..."></textarea>
            </div>

            <!-- Checkbox de datos Ley 1581 Colombia -->
            <div class="checkbox-group">
              <input type="checkbox" id="form-tratamiento" name="tratamiento" required />
              <label for="form-tratamiento">
                Autorizo el tratamiento de mis datos personales conforme a la <strong>Ley 1581 de 2012 de Colombia</strong> y la Política de Privacidad de MVC Software Studio para el envío de la propuesta técnica.
              </label>
            </div>

            <button type="submit" id="submit-btn" class="btn-primary form-submit-btn">
              <span>SOLICITAR ASESORÍA TÉCNICA SIN COSTO</span>
              <span>→</span>
            </button>

            <div id="form-status" class="form-status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 48px;
    align-items: flex-start;
  }

  .contact-left {
    display: flex;
    flex-direction: column;
  }

  .contact-title {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
    margin-bottom: 16px;
  }

  .contact-title strong {
    color: var(--primary);
  }

  .contact-lead {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* Card de confianza con radio 40px según brief */
  .trust-card {
    background-color: var(--surface);
    border-radius: 36px;
    border: 1px solid var(--border-light);
    padding: 36px 32px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
  }

  .trust-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border-light);
  }

  .trust-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--primary-soft);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-avatar svg {
    width: 24px;
    height: 24px;
  }

  .trust-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .trust-role {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .trust-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .trust-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--text);
    line-height: 1.5;
  }

  .t-check {
    width: 18px;
    height: 18px;
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Panel gris-azulado (--form-bg #EEF0F4) */
  .form-panel {
    background-color: var(--form-bg);
    border-radius: 24px;
    padding: 40px 36px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.04);
  }

  .form-header {
    margin-bottom: 24px;
  }

  .form-panel-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
  }

  .form-panel-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .project-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .input-group label {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
  }

  /* Inputs tipo píldora (radius 20px) con fondo blanco según brief */
  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--text-light);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .input-icon svg {
    width: 16px;
    height: 16px;
  }

  .input-wrapper input,
  .input-wrapper select,
  .phone-input-wrapper input,
  textarea {
    width: 100%;
    background-color: var(--surface);
    border: 1px solid #D8DCE3;
    border-radius: 9999px; /* Píldora */
    padding: 12px 18px 12px 42px;
    font-size: 0.92rem;
    color: var(--text);
    transition: all 0.2s ease;
    outline: none;
  }

  textarea {
    border-radius: 16px;
    padding: 14px 18px;
    resize: vertical;
    font-family: inherit;
  }

  .phone-input-wrapper {
    display: flex;
    align-items: center;
    background-color: var(--surface);
    border: 1px solid #D8DCE3;
    border-radius: 9999px;
    overflow: hidden;
  }

  .country-prefix {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 16px;
    padding-right: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    border-right: 1px solid #E2E6EC;
    user-select: none;
  }

  .phone-input-wrapper input {
    border: none;
    border-radius: 0;
    padding-left: 14px;
  }

  .select-wrapper select {
    padding-left: 18px;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2343474E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 16px center;
    background-size: 16px;
    cursor: pointer;
  }

  .input-wrapper input:focus,
  .input-wrapper select:focus,
  .phone-input-wrapper:focus-within,
  textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(0, 112, 245, 0.15);
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 4px;
  }

  .checkbox-group input[type="checkbox"] {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--primary);
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-group label {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    cursor: pointer;
  }

  .checkbox-group strong {
    color: var(--text);
  }

  .form-submit-btn {
    width: 100%;
    padding: 16px;
    font-size: 0.95rem;
    margin-top: 6px;
  }

  .form-status {
    font-size: 0.9rem;
    text-align: center;
    padding-top: 4px;
    min-height: 24px;
  }

  .form-status.success {
    color: #059669;
    font-weight: 600;
  }

  .form-status.error {
    color: #DC2626;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-panel {
      padding: 28px 18px;
    }
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('project-contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !submitBtn) return;

    submitBtn.setAttribute('disabled', 'true');
    statusEl.className = 'form-status';
    statusEl.textContent = 'Enviando solicitud de asesoría técnica...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // Simulation / Webhook ready for n8n or CRM
    setTimeout(() => {
      statusEl.className = 'form-status success';
      statusEl.textContent = '¡Solicitud recibida con éxito! Un arquitecto de software te contactará en menos de 24 horas.';
      form.reset();
      submitBtn.removeAttribute('disabled');
    }, 900);
  });
</script>
