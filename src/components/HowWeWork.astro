---
const steps = [
  {
    num: "01",
    title: "Diagnóstico y Arquitectura",
    desc: "Analizamos tu modelo operativo, reglas de negocio y restricciones técnicas para estructurar una arquitectura robusta y sin sorpresas.",
    icon: `<circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" />`
  },
  {
    num: "02",
    title: "Diseño UX/UI y Prototipado",
    desc: "Modelamos la experiencia de usuario y flujos clave antes de codificar, garantizando una adopción fluida por parte de tu equipo o clientes.",
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" />`
  },
  {
    num: "03",
    title: "Desarrollo Ágil en Sprints",
    desc: "Construcción iterativa con Java Spring Boot y React. Entregamos módulos funcionales y testeables cada 14 días para tu revisión.",
    icon: `<polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />`
  },
  {
    num: "04",
    title: "Testing y Aseguramiento QA",
    desc: "Pruebas unitarias, de integración y de estrés para asegurar que el sistema soporte alta concurrencia y cumpla estándares de seguridad.",
    icon: `<path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />`
  },
  {
    num: "05",
    title: "Despliegue y Automatización CI/CD",
    desc: "Configuración de pipelines automatizados, contenedores Docker y despliegue seguro en infraestructura cloud (AWS, GCP o servidores propios).",
    icon: `<path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" />`
  },
  {
    num: "06",
    title: "Evolución y Soporte Continuo",
    desc: "Acompañamiento post-lanzamiento, monitoreo de métricas, optimizaciones y escalabilidad técnica según el crecimiento de tu empresa.",
    icon: `<path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0118.8-4.3M22 12.5a10 10 0 01-18.8 4.2" />`
  }
];
---

<section class="how-we-work-section section-padding" id="metodologia">
  <div class="container">
    <div class="how-header">
      <span class="mono-eyebrow">METODOLOGÍA DE INGENIERÍA</span>
      <h2 class="how-title">Cómo Trabajamos: Del Diagnóstico a Producción</h2>
      <p class="how-subtitle">
        Un proceso estructurado, transparente y orientado a eliminar la incertidumbre en cada etapa del desarrollo de software.
      </p>
    </div>

    <!-- Grid 3x2 de tarjetas outline con borde negro según tokens -->
    <div class="how-grid">
      {steps.map((step) => (
        <article class="outline-card">
          <div class="card-step-badge">{step.num}</div>
          <div class="outline-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
          </div>
          <h3 class="outline-title">{step.title}</h3>
          <p class="outline-desc">{step.desc}</p>
        </article>
      ))}
    </div>

    <div class="how-cta-wrap">
      <a href="#contacto" class="btn-primary">
        <span>SOLICITA UNA ASESORÍA SIN COSTO</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .how-we-work-section {
    background-color: var(--bg);
  }

  .how-header {
    text-align: center;
    max-width: 780px;
    margin-inline: auto;
    margin-bottom: 60px;
  }

  .how-title {
    font-size: clamp(2rem, 3.2vw, 2.7rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 12px;
  }

  .how-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Tarjetas outline: fondo transparente, borde 1px negro, radio 15px, padding 40-45px */
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 50px;
  }

  .outline-card {
    position: relative;
    background-color: transparent;
    border: 1px solid var(--border-dark);
    border-radius: 15px;
    padding: 42px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.25s ease;
  }

  .outline-card:hover {
    background-color: var(--surface);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.04);
  }

  .card-step-badge {
    position: absolute;
    top: 20px;
    right: 24px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
  }

  .outline-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background-color: #F0F0F0;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: all 0.2s ease;
  }

  .outline-card:hover .outline-icon {
    background-color: var(--primary-soft);
    color: var(--primary);
  }

  .outline-icon svg {
    width: 26px;
    height: 26px;
  }

  .outline-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: 12px;
  }

  .outline-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .how-cta-wrap {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .how-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .how-grid {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
    .outline-card {
      padding: 36px 24px;
    }
  }
</style>
