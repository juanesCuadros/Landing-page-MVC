---
const topSectors = [
  {
    title: "Fintech & Servicios Financieros",
    desc: "Motores transaccionales de baja latencia, conciliaciones automáticas y pasarelas de pago seguras.",
    icon: `<rect x="1" y="4" width="22" height="16" rx="2" ry="2" /><line x1="1" y1="10" x2="23" y2="10" />`
  },
  {
    title: "Logística & Supply Chain",
    desc: "Sistemas de seguimiento de carga, ruteo inteligente y tableros para control de inventarios en tiempo real.",
    icon: `<rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" />`
  },
  {
    title: "Retail & E-commerce B2B",
    desc: "Portales de pedidos corporativos, sincronización de existencias multidestino y facturación electrónica.",
    icon: `<circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />`
  }
];

const bottomSectors = [
  {
    title: "Salud & HealthTech",
    desc: "Software para gestión de citas médicas, plataformas de telemedicina e interoperabilidad clínica bajo estrictos estándares de protección de datos.",
    icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2" />`
  },
  {
    title: "Servicios B2B & Consultoría",
    desc: "Automatización de flujos de trabajo con n8n, portales de autoservicio para clientes e integración transparente con CRMs comerciales como Kommo.",
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />`
  }
];
---

<section class="sectors-section section-padding" id="sectores">
  <div class="container">
    <div class="sectors-header">
      <span class="mono-eyebrow">EXPERIENCIA VERTICAL</span>
      <h2 class="sectors-title">Sectores Donde Generamos Mayor Valor</h2>
      <p class="sectors-subtitle">
        Diseñamos software que entiende la lógica regulatoria y operativa de industrias con alta exigencia técnica.
      </p>
    </div>

    <!-- Estilo de tarjetas outline: 3 arriba + 2 anchas abajo según brief -->
    <div class="sectors-top-grid">
      {topSectors.map((s) => (
        <article class="sector-card">
          <div class="sector-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </div>
          <h3 class="sector-title">{s.title}</h3>
          <p class="sector-desc">{s.desc}</p>
        </article>
      ))}
    </div>

    <div class="sectors-bottom-grid">
      {bottomSectors.map((s) => (
        <article class="sector-card wide">
          <div class="sector-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </div>
          <div class="sector-text-wrap">
            <h3 class="sector-title">{s.title}</h3>
            <p class="sector-desc">{s.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sectors-section {
    background-color: var(--bg);
  }

  .sectors-header {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
    margin-bottom: 50px;
  }

  .sectors-title {
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 12px;
  }

  .sectors-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .sectors-top-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 24px;
  }

  .sectors-bottom-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* Tarjeta outline: fondo transparente, border 1px solid #000, radius 15px, padding 40px */
  .sector-card {
    background-color: transparent;
    border: 1px solid var(--border-dark);
    border-radius: 15px;
    padding: 38px 30px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.25s ease;
  }

  .sector-card:hover {
    background-color: var(--surface);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.04);
  }

  .sector-card.wide {
    flex-direction: row;
    text-align: left;
    gap: 24px;
    align-items: center;
  }

  .sector-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-color: #ECECEC;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .sector-card.wide .sector-icon {
    margin-bottom: 0;
  }

  .sector-card:hover .sector-icon {
    background-color: var(--primary-soft);
    color: var(--primary);
  }

  .sector-icon svg {
    width: 24px;
    height: 24px;
  }

  .sector-title {
    font-size: 1.22rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    margin-bottom: 10px;
  }

  .sector-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .sectors-top-grid, .sectors-bottom-grid {
      grid-template-columns: 1fr;
    }
    .sector-card.wide {
      flex-direction: column;
      text-align: center;
    }
    .sector-card.wide .sector-icon {
      margin-bottom: 20px;
    }
  }
</style>
