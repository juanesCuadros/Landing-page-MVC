---
const technologies = [
  { name: "JAVA 21", category: "Backend" },
  { name: "SPRING BOOT 3", category: "Framework" },
  { name: "REACT 19", category: "Frontend" },
  { name: "TYPESCRIPT", category: "Language" },
  { name: "N8N AUTOMATION", category: "Workflows" },
  { name: "POSTGRESQL", category: "Database" },
  { name: "DOCKER", category: "DevOps" },
  { name: "PYTHON", category: "Data / AI" },
  { name: "REDIS CACHE", category: "Performance" },
  { name: "AWS CLOUD", category: "Infrastructure" },
  { name: "REST APIS", category: "Architecture" },
  { name: "POWER BI / METABASE", category: "Analytics" }
];
---

<section class="tech-section section-padding" id="tecnologias">
  <div class="container">
    <div class="tech-header">
      <span class="mono-eyebrow">STACK TECNOLÓGICO</span>
      <h2 class="tech-title">Tecnologías en las que Trabajamos</h2>
      <p class="tech-subtitle">
        Seleccionamos frameworks consolidados en la industria para garantizar rendimiento, seguridad a largo plazo y facilidad para encontrar talento.
      </p>
    </div>

    <!-- Chips tipo pill blancos en filas centradas -->
    <div class="tech-chips-wrap">
      {technologies.map((tech) => (
        <div class="tech-pill">
          <span class="tech-bullet"></span>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-section {
    background-color: var(--surface);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .tech-header {
    text-align: center;
    max-width: 740px;
    margin-inline: auto;
    margin-bottom: 48px;
  }

  .tech-title {
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 12px;
  }

  .tech-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .tech-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    max-width: 1000px;
    margin-inline: auto;
  }

  /* Chip pill: fondo blanco, radio 20px, padding 12x24, Inter Tight (var(--font-mono)) uppercase */
  .tech-pill {
    background-color: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: 9999px;
    padding: 12px 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease;
    cursor: default;
  }

  .tech-pill:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 112, 245, 0.08);
  }

  .tech-bullet {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primary);
  }

  .tech-name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--text);
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .tech-chips-wrap {
      gap: 10px;
    }
    .tech-pill {
      padding: 10px 18px;
    }
  }
</style>
